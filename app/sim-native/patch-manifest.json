      "preferences": "{model,effort,max_tokens}",
      "workflow_tools": false,
      "recorded_spend": "optional ledger status"
    },
    "credential_fallback": "none; host OS vault only",
    "native_settings_path": "/workspace/{UUID}/settings/byok",
    "write_origin": "validated NEXT_PUBLIC_APP_URL origin; request origin only when unset",
    "completion_errors": "With MINUS_OPENROUTER_CHAT=true and complete/status:error, fixed runtime reason messages enter context.errors; unknown reasons use a fixed generic message. Success/accounting/receipts unchanged."
