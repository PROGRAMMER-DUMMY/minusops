  "interface": {
    "feature_flag": "MINUS_OPENROUTER_CHAT=true",
    "gateway_origin": "http://host.docker.internal:5180",
    "gateway_token_env": "MINUS_ASSISTANT_GATEWAY_TOKEN",
    "gateway_token_header": "X-Minus-Bridge-Token",
    "gateway_paths": "/workspaces/{UUID}/{status|key|models|preferences|architecture}",
    "preferences": {
      "model": "string|null",
      "effort": "string|null",
      "max_tokens": "integer 1..32768"
    },
    "credential_methods": [
      "POST {key}",
      "DELETE without body"
    ],
    "send_path_modified": false,
    "status": {
      "provider": "openrouter",
      "providers": {
        "openrouter": "sanitized vault-only AIStatus"
      },
      "preferences": "{model,effort,max_tokens}",
      "workflow_tools": false,
      "recorded_spend": "optional ledger status"
    },
    "credential_fallback": "none; host OS vault only",
    "native_settings_path": "/workspace/{UUID}/settings/byok",
    "write_origin": "validated NEXT_PUBLIC_APP_URL origin; request origin only when unset",
    "completion_errors": "With MINUS_OPENROUTER_CHAT=true and complete/status:error, fixed runtime reason messages enter context.errors; unknown reasons use a fixed generic message. Success/accounting/receipts unchanged.",
    "architecture": "Run-bound GET ?run_id; finite library/source operations; sticky chat binding with authenticated native user; no publish/apply"
  },
